import java.io.FileReader;
import java.io.IOException;

public class Main {
    public static void main(String[] args) {
        StringBuilder text = new StringBuilder();
        try(FileReader fileReader = new FileReader("/home/user2/Рабочий стол/file1.txt")){
            int c;
            while ((c = fileReader.read()) != -1){
                text.append((char)c);
            }
        } catch (IOException ex){
            System.out.println(ex.getMessage());
            return;
        }

        int numberOfWords = 0;
        int numberOfLetters = 0;
        int numberOfSentences = 0;

        for (int i = 0; i<text.length(); i++){
            if (text.substring(i, i+1).equals(" ")){
                numberOfWords ++;
            }
        }

        for (int i = 0; i<text.length(); i++){
            if (text.substring(i, i+1).equals(".") || text.substring(i, i+1).equals("!") || text.substring(i, i+1).equals("?")){
                numberOfSentences ++;
            }
        }

        for (int i = 0; i<text.length(); i++){
            if (Character.isLetter(text.charAt(i))) {
                numberOfLetters ++;
            }
        }

        if (numberOfWords > 0){
            numberOfWords ++;
        }
        System.out.println("Количество слов: " + numberOfWords);
        System.out.println("Количество букв: " + numberOfLetters);
        System.out.println("Количество предложений: " + numberOfSentences);
    }
}
